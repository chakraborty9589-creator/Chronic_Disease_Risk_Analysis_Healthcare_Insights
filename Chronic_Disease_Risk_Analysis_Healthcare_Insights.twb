<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.2.0 (20262.26.0912.1023)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AccessibleZoneTabOrder />
    <AutoCreateAndUpdateDSDPhoneLayouts />
    <SetMembershipControl />
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='smart_healthcare_dataset' inline='true' name='federated.smart_healthcare_dataset' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='smart_healthcare_dataset' name='textscan.smart_healthcare_dataset'>
            <connection class='textscan' directory='C:/Users/soumadip/Desktop/HEALTH WALA' filename='smart_healthcare_dataset.csv' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.smart_healthcare_dataset' name='smart_healthcare_dataset.csv' table='[smart_healthcare_dataset#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='integer' name='age' ordinal='0' />
            <column datatype='string' name='gender' ordinal='1' />
            <column datatype='real' name='bmi' ordinal='2' />
            <column datatype='integer' name='exercise_level' ordinal='3' />
            <column datatype='integer' name='smoking' ordinal='4' />
            <column datatype='integer' name='alcohol' ordinal='5' />
            <column datatype='integer' name='blood_pressure' ordinal='6' />
            <column datatype='integer' name='cholesterol' ordinal='7' />
            <column datatype='integer' name='glucose' ordinal='8' />
            <column datatype='integer' name='fatigue' ordinal='9' />
            <column datatype='integer' name='chest_pain' ordinal='10' />
            <column datatype='integer' name='dizziness' ordinal='11' />
            <column datatype='integer' name='heart_disease' ordinal='12' />
            <column datatype='integer' name='diabetes' ordinal='13' />
            <column datatype='integer' name='stroke' ordinal='14' />
            <column datatype='real' name='health_risk_score' ordinal='15' />
          </columns>
        </relation>
      </connection>
      
      <!-- Standard Number of Records Measure -->
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      
      <!-- Calculated Field 1: Age Group -->
      <column caption='Age Group' datatype='string' name='[Calculation_AgeGroup]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 30 THEN &quot;Under 30&quot;&#10;ELSEIF [age] &lt;= 39 THEN &quot;30-39&quot;&#10;ELSEIF [age] &lt;= 49 THEN &quot;40-49&quot;&#10;ELSEIF [age] &lt;= 59 THEN &quot;50-59&quot;&#10;ELSEIF [age] &lt;= 69 THEN &quot;60-69&quot;&#10;ELSE &quot;70 and above&quot;&#10;END' />
      </column>
      
      <!-- Calculated Field 2: BMI Category -->
      <column caption='BMI Category' datatype='string' name='[Calculation_BmiCategory]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight (&lt;18.5)&quot;&#10;ELSEIF [bmi] &lt; 25.0 THEN &quot;Normal weight (18.5-24.9)&quot;&#10;ELSEIF [bmi] &lt; 30.0 THEN &quot;Overweight (25.0-29.9)&quot;&#10;ELSE &quot;Obesity (&gt;=30.0)&quot;&#10;END' />
      </column>
      
      <!-- Calculated Field 3: Heart Disease Status -->
      <column caption='Heart Disease Status' datatype='string' name='[Calculation_HDStatus]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [heart_disease] = 1 THEN &quot;Positive&quot; ELSEIF [heart_disease] = 0 THEN &quot;Negative&quot; ELSE &quot;Unknown&quot; END' />
      </column>
      
      <!-- Calculated Field 4: Diabetes Status -->
      <column caption='Diabetes Status' datatype='string' name='[Calculation_DiabetesStatus]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [diabetes] = 1 THEN &quot;Positive&quot; ELSEIF [diabetes] = 0 THEN &quot;Negative&quot; ELSE &quot;Unknown&quot; END' />
      </column>
      
      <!-- Calculated Field 5: Stroke Status -->
      <column caption='Stroke Status' datatype='string' name='[Calculation_StrokeStatus]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stroke] = 1 THEN &quot;Positive&quot; ELSEIF [stroke] = 0 THEN &quot;Negative&quot; ELSE &quot;Unknown&quot; END' />
      </column>
      
      <!-- Calculated Field 6: Heart Disease Prevalence (%) -->
      <column caption='Heart Disease Prevalence (%)' datatype='real' name='[Calculation_HDPrev]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([heart_disease]) / COUNT([heart_disease])) * 100' />
      </column>
      
      <!-- Calculated Field 7: Diabetes Prevalence (%) -->
      <column caption='Diabetes Prevalence (%)' datatype='real' name='[Calculation_DiabetesPrev]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([diabetes]) / COUNT([diabetes])) * 100' />
      </column>
      
      <!-- Calculated Field 8: Stroke Prevalence (%) -->
      <column caption='Stroke Prevalence (%)' datatype='real' name='[Calculation_StrokePrev]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([stroke]) / COUNT([stroke])) * 100' />
      </column>
      
      <!-- Calculated Field 9: Exercise Level Label -->
      <column caption='Exercise Level Label' datatype='string' name='[Calculation_ExerciseLabel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [exercise_level] = 0 THEN &quot;Sedentary (Level 0)&quot; ELSEIF [exercise_level] = 1 THEN &quot;Moderate (Level 1)&quot; ELSE &quot;Active (Level 2)&quot; END' />
      </column>
      
      <!-- Calculated Field 10: Smoking Status Label -->
      <column caption='Smoking Status Label' datatype='string' name='[Calculation_SmokingLabel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [smoking] = 1 THEN &quot;Smoker&quot; ELSE &quot;Non-Smoker&quot; END' />
      </column>
      
      <!-- Calculated Field 11: Alcohol Consumption Label -->
      <column caption='Alcohol Consumption Label' datatype='string' name='[Calculation_AlcoholLabel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [alcohol] = 1 THEN &quot;Drinker&quot; ELSE &quot;Non-Drinker&quot; END' />
      </column>
      
      <!-- Calculated Field 12: Fatigue Label -->
      <column caption='Fatigue Label' datatype='string' name='[Calculation_FatigueLabel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fatigue] = 1 THEN &quot;Fatigue Reported&quot; ELSE &quot;No Fatigue&quot; END' />
      </column>
      
      <!-- Calculated Field 13: Chest Pain Label -->
      <column caption='Chest Pain Label' datatype='string' name='[Calculation_ChestPainLabel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [chest_pain] = 1 THEN &quot;Chest Pain Reported&quot; ELSE &quot;No Chest Pain&quot; END' />
      </column>
      
      <!-- Calculated Field 14: Dizziness Label -->
      <column caption='Dizziness Label' datatype='string' name='[Calculation_DizzinessLabel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dizziness] = 1 THEN &quot;Dizziness Reported&quot; ELSE &quot;No Dizziness&quot; END' />
      </column>
      
      <!-- Calculated Field 15: Health Risk Score Data Quality Note -->
      <column caption='Health Risk Score Note' datatype='string' name='[Calculation_RiskScoreNote]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Data Quality Note: Health Risk Score is constant at 100.0 across all 5,000 records. Non-discriminative for clinical risk ranking.&quot;' />
      </column>
      
      <!-- Column aliases / roles -->
      <column caption='Age' datatype='integer' name='[age]' role='dimension' type='quantitative' />
      <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
      <column caption='BMI' datatype='real' name='[bmi]' role='measure' type='quantitative' />
      <column caption='Blood Pressure' datatype='integer' name='[blood_pressure]' role='measure' type='quantitative' />
      <column caption='Cholesterol' datatype='integer' name='[cholesterol]' role='measure' type='quantitative' />
      <column caption='Glucose' datatype='integer' name='[glucose]' role='measure' type='quantitative' />
      <column caption='Heart Disease' datatype='integer' name='[heart_disease]' role='measure' type='quantitative' />
      <column caption='Diabetes' datatype='integer' name='[diabetes]' role='measure' type='quantitative' />
      <column caption='Stroke' datatype='integer' name='[stroke]' role='measure' type='quantitative' />
      <column caption='Health Risk Score' datatype='real' name='[health_risk_score]' role='measure' type='quantitative' />
    </datasource>
  </datasources>

  <worksheets>
    <!-- WORKSHEET 1: Overall Disease Prevalence -->
    <worksheet name='Overall Disease Prevalence'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset' name='federated.smart_healthcare_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.smart_healthcare_dataset'>
            <column caption='Heart Disease Prevalence (%)' datatype='real' name='[Calculation_HDPrev]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([heart_disease]) / COUNT([heart_disease])) * 100' />
            </column>
            <column caption='Diabetes Prevalence (%)' datatype='real' name='[Calculation_DiabetesPrev]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([diabetes]) / COUNT([diabetes])) * 100' />
            </column>
            <column caption='Stroke Prevalence (%)' datatype='real' name='[Calculation_StrokePrev]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([stroke]) / COUNT([stroke])) * 100' />
            </column>
            <column-instance column='[Calculation_HDPrev]' derivation='User' name='[usr:Calculation_HDPrev:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_DiabetesPrev]' derivation='User' name='[usr:Calculation_DiabetesPrev:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_StrokePrev]' derivation='User' name='[usr:Calculation_StrokePrev:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_dataset].[Multiple Values]</rows>
        <cols>[federated.smart_healthcare_dataset].[:Measure Names]</cols>
      </table>
      <simple-id uuid='{WS-0001-0001-0001-000000000001}' />
    </worksheet>

    <!-- WORKSHEET 2: Disease Distribution (Counts) -->
    <worksheet name='Disease Distribution'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset' name='federated.smart_healthcare_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.smart_healthcare_dataset'>
            <column caption='Heart Disease' datatype='integer' name='[heart_disease]' role='measure' type='quantitative' />
            <column caption='Diabetes' datatype='integer' name='[diabetes]' role='measure' type='quantitative' />
            <column caption='Stroke' datatype='integer' name='[stroke]' role='measure' type='quantitative' />
            <column-instance column='[heart_disease]' derivation='Sum' name='[sum:heart_disease:qk]' pivot='key' type='quantitative' />
            <column-instance column='[diabetes]' derivation='Sum' name='[sum:diabetes:qk]' pivot='key' type='quantitative' />
            <column-instance column='[stroke]' derivation='Sum' name='[sum:stroke:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_dataset].[Multiple Values]</rows>
        <cols>[federated.smart_healthcare_dataset].[:Measure Names]</cols>
      </table>
      <simple-id uuid='{WS-0002-0002-0002-000000000002}' />
    </worksheet>

