    <!-- WORKSHEET 10: Gender & Age Demographics -->
    <worksheet name='Demographic Overview'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset' name='federated.smart_healthcare_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.smart_healthcare_dataset'>
            <column caption='Age Group' datatype='string' name='[Calculation_AgeGroup]' role='dimension' type='nominal' />
            <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_AgeGroup]' derivation='None' name='[none:Calculation_AgeGroup:nk]' pivot='key' type='nominal' />
            <column-instance column='[gender]' derivation='None' name='[none:gender:nk]' pivot='key' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.smart_healthcare_dataset].[none:gender:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_dataset].[sum:Number of Records:qk]</rows>
        <cols>[federated.smart_healthcare_dataset].[none:Calculation_AgeGroup:nk]</cols>
      </table>
      <simple-id uuid='{WS-0010-0010-0010-000000000010}' />
    </worksheet>

    <!-- WORKSHEET 11: Summary Findings / KPI Card -->
    <worksheet name='Key Findings'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset' name='federated.smart_healthcare_dataset' />
          </datasources>
          <datasource-dependencies datasource='federated.smart_healthcare_dataset'>
            <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' />
            <column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.smart_healthcare_dataset].[sum:Number of Records:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols>[federated.smart_healthcare_dataset].[sum:Number of Records:qk]</cols>
      </table>
      <simple-id uuid='{WS-0011-0011-0011-000000000011}' />
    </worksheet>
  </worksheets>

  <dashboards>
    <dashboard name='Chronic Disease Risk Analysis Dashboard'>
      <style />
      <size maxheight='1000' maxwidth='1440' minheight='1000' minwidth='1440' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
